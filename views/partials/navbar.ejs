<header class="navbar">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="MockBase home">
      <img src="/images/favicon.svg" alt="" width="30" height="30">
      <span>MockBase</span>
    </a>

    <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
      <%- include('icon', { name: 'menu' }) %>
    </button>

    <nav class="nav-links" id="navLinks" aria-label="Main">
      <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
      <a href="/about" class="<%= active === 'about' ? 'active' : '' %>">About</a>
      <a href="/docs" class="<%= active === 'docs' ? 'active' : '' %>">Documentation</a>
      <% if (githubUrl) { %>
        <a href="<%= githubUrl %>" class="nav-github" target="_blank" rel="noopener noreferrer">
          <%- include('icon', { name: 'github' }) %><span>GitHub</span>
        </a>
      <% } %>
    </nav>
  </div>
</header>
